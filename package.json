{
    "name": "LedgerMap",
    "version": "1.3.2",
    "description": "Forecasts a graph of costs and expenses",
    "license": "MIT",
    "main": "main.js",
    "scripts": {
        "start": "electron ."
    },
    "devDependencies": {
        "electron": "^44.4.3",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.ledger.map",
        "productName": "LedgerMap",
        "publish": {
            "provider": "github",
            "owner": "farismuhammad17",
            "repo": "LedgerMap"
        },
        "files": [
            "main.js",
            "package.json",
            "*.html",
            "scripts/*.js",
            "styles/*.css"
        ],
        "win": {
            "target": [
                "nsis"
            ]
        },
        "mac": {
            "target": [
                "dmg"
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ]
        }
    },
    "dependencies": {
        "electron-updater": "^6.8.9"
    }
}
