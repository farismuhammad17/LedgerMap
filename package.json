{
    "name": "LedgerMap",
    "version": "1.2.0",
    "description": "Forecasts a graph of costs and expenses",
    "license": "MIT",
    "main": "main.js",
    "scripts": {
        "start": "electron ."
    },
    "devDependencies": {
        "electron": "^44.4.3",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.ledger.map",
        "productName": "LedgerMap",
        "files": [
            "main.js",
            "index.html",
            "package.json"
        ],
        "win": {
            "target": [
                "nsis"
            ]
        },
        "mac": {
            "target": [
                "dmg"
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ]
        }
    }
}
